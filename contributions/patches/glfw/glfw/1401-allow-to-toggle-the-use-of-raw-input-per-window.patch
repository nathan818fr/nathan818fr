From 86544e7c3af04dad905563b4285186c8e398f2b6 Mon Sep 17 00:00:00 2001
From: Nathan Poirier <nathan@poirier.io>
Date: Fri, 14 Dec 2018 05:23:11 +0100
Subject: [PATCH 07/14] Add raw input toggle key to cursor example

---
 tests/cursor.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/tests/cursor.c b/tests/cursor.c
index 4cc74ad515..6d88c23cf8 100644
--- a/tests/cursor.c
+++ b/tests/cursor.c
@@ -163,6 +163,19 @@ static void key_callback(GLFWwindow* window, int key, int scancode, int action,
             printf("(( cursor is hidden ))\n");
             break;
 
+        case GLFW_KEY_R:
+            if (glfwGetWindowUseRawInput(window))
+            {
+                glfwSetWindowUseRawInput(window, GLFW_FALSE);
+                printf("(( raw input is disabled ))\n");
+            }
+            else
+            {
+                glfwSetWindowUseRawInput(window, GLFW_TRUE);
+                printf("(( raw input is enabled ))\n");
+            }
+            break;
+
         case GLFW_KEY_SPACE:
             swap_interval = 1 - swap_interval;
             printf("(( swap interval: %i ))\n", swap_interval);

