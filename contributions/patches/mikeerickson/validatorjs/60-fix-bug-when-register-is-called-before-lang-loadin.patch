From eb4067c1df721430014ac770e0df8cd95a0b08de Mon Sep 17 00:00:00 2001
From: Nathan Poirier <nathan@poirier.io>
Date: Fri, 31 Jul 2015 23:52:42 +0200
Subject: [PATCH 1/4] Fix Validator.register error before lang loading

Fix "Cannot set property X of undefined" when using Validator.register before lang loading.
---
 src/lang.js | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/lang.js b/src/lang.js
index 46076cfd..7e4ece2d 100644
--- a/src/lang.js
+++ b/src/lang.js
@@ -24,6 +24,8 @@ var container = {
 	 * @return {void}
 	 */
 	_setRuleMessage: function(lang, attribute, message) {
+		this._load();
+		
 		if (message === undefined) {
 			message = this.messages[lang].def;
 		}
@@ -68,4 +70,4 @@ var container = {
 
 };
 
-module.exports = container;
\ No newline at end of file
+module.exports = container;

