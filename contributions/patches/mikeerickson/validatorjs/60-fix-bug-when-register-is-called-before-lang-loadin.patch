From b44fff1d9daff52a97bee3c132fa31eb53566cd6 Mon Sep 17 00:00:00 2001
From: Nathan Poirier <nathan@poirier.io>
Date: Sat, 1 Aug 2015 00:37:30 +0200
Subject: [PATCH 3/4] allow registering of implicit rules

---
 src/rules.js     | 7 ++++++-
 src/validator.js | 5 +++--
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/rules.js b/src/rules.js
index 7f55320a..c9db3dc8 100644
--- a/src/rules.js
+++ b/src/rules.js
@@ -359,10 +359,15 @@ var manager = {
 	 *
 	 * @param  {string}   name
 	 * @param  {function} fn
+	 * @param  {boolean}  isImplicit
 	 * @return {void}
 	 */
-	register: function(name, fn) {
+	register: function(name, fn, isImplicit) {
 		rules[name] = fn;
+		if (isImplicit)
+		{
+			this.implicitRules.push(name);
+		}
 	},
 
 	/**
diff --git a/src/validator.js b/src/validator.js
index 212f7341..551a086b 100644
--- a/src/validator.js
+++ b/src/validator.js
@@ -338,11 +338,12 @@ Validator.getDefaultLang = function() {
  * @param  {string}   name
  * @param  {function} fn
  * @param  {string}   message
+ * @param  {boolean}  isImplicit
  * @return {void}
  */
-Validator.register = function(name, fn, message) {
+Validator.register = function(name, fn, message, isImplicit) {
 	var lang = Validator.getDefaultLang();
-	Rules.register(name, fn);
+	Rules.register(name, fn, isImplicit);
 	Lang._setRuleMessage(lang, name, message);
 };
 

