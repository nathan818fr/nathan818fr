From 7362ba3f18bc31a744771a63d3991ae5b347e75b Mon Sep 17 00:00:00 2001
From: Nathan Poirier <nathan@poirier.io>
Date: Fri, 5 Dec 2014 17:56:40 +0100
Subject: [PATCH 4/5] epitech inactive emblem when away/lock

---
 src/netsoul.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/netsoul.c b/src/netsoul.c
index 95b6d40..d3270c6 100644
--- a/src/netsoul.c
+++ b/src/netsoul.c
@@ -543,7 +543,13 @@ static const char* netsoul_list_emblems(PurpleBuddy *buddy)
       nc = tmp->data;
       if (nc && nc->ip &&
 	  nc->ip[0] == '1' && nc->ip[1] == '0' && nc->ip[2] == '.')
-	return "epitech";
+	{
+	  if ((nb->state == NS_STATE_AWAY) || (nb->state == NS_STATE_IDLE) ||
+	      (nb->state == NS_STATE_SERVER) || (nb->state == NS_STATE_LOCK) ||
+	      (nb->state == NS_STATE_SEVERAL_INACTIF))
+	    return "epitech_inactive";
+	  return "epitech";
+	}
     }
   return NULL;
 }

