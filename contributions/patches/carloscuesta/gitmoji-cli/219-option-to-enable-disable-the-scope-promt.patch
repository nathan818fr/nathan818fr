   config.set(constants.SIGNED_COMMIT, signedCommit)
 }
+const setScopePrompt = (scopePrompt) => {
+  config.set(constants.SCOPE_PROMPT, scopePrompt)
+}
 
 module.exports = {
   getAutoAdd,
   getEmojiFormat,
   getSignedCommit,
+  getScopePrompt,
   setAutoAdd,
   setEmojiFormat,
-  setSignedCommit
+  setSignedCommit,
+  setScopePrompt
 }
